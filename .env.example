# Bellport Watch — Environment Configuration Example
# Copy to .env.local (never commit .env.local to Git, and never prefix secrets with VITE_).

# Free RealtyAPI key (https://www.realtyapi.io — 250 free calls/mo, no credit card)
# Can also be pasted directly inside the app's Sync modal.
REALTYAPI_KEY=

# Optional Gemini Developer API key for AI-refined Architectural Taste memos
# Falls back automatically to local architectural DNA synthesis if omitted.
GEMINI_API_KEY=

DEV_AUTH_BYPASS=true
