# Bellport Watch — Environment Configuration Example
# Never commit real .env or .env.local files to Git.
# Never prefix secrets with VITE_ (which bundles them into client JS).

# Local development auth bypass (ignored when NODE_ENV === 'production')
DEV_AUTH_BYPASS=true

# Optional future server-side integrations (Phase 2+)
AI_ENABLED=false
GEMINI_API_KEY=
RENTCAST_API_KEY=
ALLOWED_EMAILS=
